use Interop.C
use STD.Text.UTF8

public enum Kind {
    document
    element
    text
    cdata
    comment
    processing_instruction
}

public enum Format { compact; pretty }

public struct Attribute {
    let name:str
    let value:str
}

public struct ParseOptions {
    let maximum_bytes:int
    let maximum_nodes:int
    let maximum_depth:int
}

public enum ParseErrorKind {
    unexpected_end
    unexpected_token
    invalid_name
    duplicate_attribute
    mismatched_element
    multiple_roots
    missing_root
    invalid_entity
    unsupported_doctype
    byte_limit
    node_limit
    depth_limit
}

public struct ParseError {
    let kind:ParseErrorKind
    let byte_offset:int
    let line:int
    let column:int
    let detail:str
}

public class Node {
    private let raw_kind:int
    private var node_name:str
    private var node_value:str
    private var node_attributes:Attribute[]
    private var node_children:Node[]

    package init(raw_kind:int, name:str, value:str) {
        self.raw_kind = raw_kind
        self.node_name = name
        self.node_value = value
        self.node_attributes = []
        self.node_children = []
    }

    static func document() Node { return Node(1, "", "") }

    static func element(name:str) Node {
        if !valid_name(name) { panic("invalid XML element name '$(name)'") }
        return Node(2, name, "")
    }

    static func text(value:str) Node { return Node(3, "", value) }
    static func cdata(value:str) Node { return Node(4, "", value) }

    static func comment(value:str) Node {
        if contains(value, "--") || ends_with(value, "-") { panic("XML comment cannot contain '--' or end with '-'") }
        return Node(5, "", value)
    }

    static func processing_instruction(target:str, value:str = "") Node {
        if !valid_name(target) || ascii_lower(target) == "xml" {
            panic("invalid XML processing-instruction target '$(target)'")
        }
        if contains(value, "?>") { panic("XML processing instruction cannot contain '?>'") }
        return Node(6, target, value)
    }

    func kind() Kind {
        if self.raw_kind == 1 { return Kind.document }
        if self.raw_kind == 2 { return Kind.element }
        if self.raw_kind == 3 { return Kind.text }
        if self.raw_kind == 4 { return Kind.cdata }
        if self.raw_kind == 5 { return Kind.comment }
        return Kind.processing_instruction
    }

    func name() str? {
        if self.raw_kind == 2 || self.raw_kind == 6 { return self.node_name }
        return null
    }

    func value() str? {
        if self.raw_kind >= 3 { return self.node_value }
        return null
    }

    func attributes() Attribute[] { return self.node_attributes }
    func children() Node[] { return self.node_children }

    func attribute(name:str) str? {
        for attribute in self.node_attributes {
            if attribute.name == name { return attribute.value }
        }
        return null
    }

    func has_attribute(name:str) bool { return self.attribute(name) != null }

    func set_attribute(name:str, value:str) {
        self.require_element("set_attribute")
        if !valid_name(name) { panic("invalid XML attribute name '$(name)'") }
        var index = 0
        while index < self.node_attributes.count() {
            if self.node_attributes[index].name == name {
                self.node_attributes[index] = Attribute(name:name, value:value)
                return
            }
            index++
        }
        self.node_attributes.append(Attribute(name:name, value:value))
    }

    func remove_attribute(name:str) bool {
        self.require_element("remove_attribute")
        var index = 0
        while index < self.node_attributes.count() {
            if self.node_attributes[index].name == name {
                self.node_attributes.take(index)
                return true
            }
            index++
        }
        return false
    }

    func append(child:Node) {
        if self.raw_kind != 1 && self.raw_kind != 2 {
            panic("XML children can only be appended to a document or element")
        }
        self.node_children.append(child)
    }

    func append_element(name:str) Node {
        var child = Node.element(name)
        self.append(child)
        return child
    }

    func append_text(value:str) Node {
        var child = Node.text(value)
        self.append(child)
        return child
    }

    func append_cdata(value:str) Node {
        var child = Node.cdata(value)
        self.append(child)
        return child
    }

    func text_content() str {
        if self.raw_kind == 3 || self.raw_kind == 4 { return self.node_value }
        var result = ""
        for child in self.node_children { result += child.text_content() }
        return result
    }

    func elements(name:str) Node[] {
        var result:Node[] = []
        self.collect(name, result)
        return result
    }

    func root() Node? {
        if self.raw_kind != 1 { return null }
        for child in self.node_children {
            if child.raw_kind_value() == 2 { return child }
        }
        return null
    }

    private func require_element(operation:str) {
        if self.raw_kind != 2 { panic("XML $(operation) requires an element") }
    }

    private func collect(name:str, output:&Node[]) {
        if self.raw_kind == 2 && (name == "*" || self.node_name == name) { output.append(self) }
        for child in self.node_children { child.collect(name, output) }
    }

    package func raw_kind_value() int { return self.raw_kind }
    package func raw_name() str { return self.node_name }
    package func raw_value() str { return self.node_value }
    package func raw_attributes() Attribute[] { return self.node_attributes }
    package func raw_children() Node[] { return self.node_children }
}

public func document() Node { return Node.document() }
public func element(name:str) Node { return Node.element(name) }

public func default_parse_options() ParseOptions {
    return ParseOptions(
        maximum_bytes:8 * 1024 * 1024,
        maximum_nodes:250_000,
        maximum_depth:512
    )
}

public func parse(source:str) Result<Node, ParseError> {
    return (try parse(source, default_parse_options()))
}

public func parse(source:str, options:ParseOptions) Result<Node, ParseError> {
    return (try Parser(source, options).run())
}


public func serialize(node:Node) str { return serialize(node, Format.compact) }

public func serialize(node:Node, format:Format) str {
    var output:uint8[] = []
    encode(node, output, format == Format.pretty, 0, false)
    return bytes_text(output, 0, output.count())
}

class Parser {
    private let input:uint8[]
    private let options:ParseOptions
    private var offset:int
    private var node_count:int
    private var root_count:int

    init(source:str, options:ParseOptions) {
        self.input = UTF8.bytes(source)
        self.options = options
        self.offset = 0
        self.node_count = 1
        self.root_count = 0
    }

    func run() Result<Node, ParseError> {
        if self.options.maximum_bytes < 0 || self.input.count() > self.options.maximum_bytes {
            return (try self.failure(ParseErrorKind.byte_limit, "XML input exceeds maximum_bytes"))
        }
        if self.options.maximum_nodes < 1 { return (try self.failure(ParseErrorKind.node_limit, "maximum_nodes must be positive")) }
        if self.options.maximum_depth < 1 { return (try self.failure(ParseErrorKind.depth_limit, "maximum_depth must be positive")) }
        if starts_at(self.input, 0, "﻿") { self.offset = 3 }
        var document = Node.document()
        var stack:Node[] = [document]
        while self.offset < self.input.count() {
            if self.input[self.offset] != 60 {
                match (try self.read_text(stack)) {
                    success => {}
                    failure(error) => { return Result<Node, ParseError>.failure(error) }
                }
                continue
            }
            if starts_at(self.input, self.offset, "<!--") {
                match (try self.read_comment(stack)) { success => {}; failure(error) => { return Result<Node, ParseError>.failure(error) } }
                continue
            }
            if starts_at(self.input, self.offset, "<![CDATA[") {
                match (try self.read_cdata(stack)) { success => {}; failure(error) => { return Result<Node, ParseError>.failure(error) } }
                continue
            }
            if starts_at(self.input, self.offset, "<!DOCTYPE") || starts_at(self.input, self.offset, "<!doctype") {
                return (try self.failure(ParseErrorKind.unsupported_doctype, "XML DTD declarations are not supported"))
            }
            if starts_at(self.input, self.offset, "<?") {
                match (try self.read_instruction(stack)) { success => {}; failure(error) => { return Result<Node, ParseError>.failure(error) } }
                continue
            }
            if starts_at(self.input, self.offset, "</") {
                match (try self.read_close(stack)) { success => {}; failure(error) => { return Result<Node, ParseError>.failure(error) } }
                continue
            }
            match (try self.read_open(stack)) { success => {}; failure(error) => { return Result<Node, ParseError>.failure(error) } }
        }
        if stack.count() != 1 { return (try self.failure(ParseErrorKind.unexpected_end, "XML document ended before its root element closed")) }
        if self.root_count == 0 { return (try self.failure(ParseErrorKind.missing_root, "XML document requires one root element")) }
        return Result<Node, ParseError>.success(document)
    }

    private func read_text(stack:&Node[]) Result<void, ParseError> {
        let start = self.offset
        while self.offset < self.input.count() && self.input[self.offset] != 60 { self.offset++ }
        let source = bytes_text(self.input, start, self.offset)
        var value = ""
        match (try decode_entities(source)) {
            success(decoded) => { value = decoded }
            failure(detail) => { return (try self.failure_void(ParseErrorKind.invalid_entity, detail)) }
        }
        if stack.count() == 1 {
            if !only_space(value) { return (try self.failure_void(ParseErrorKind.unexpected_token, "text is not allowed outside the XML root element")) }
            if value == "" { return Result<void, ParseError>.success() }
        }
        return (try self.append(stack, Node.text(value), stack.count()))
    }

    private func read_comment(stack:&Node[]) Result<void, ParseError> {
        self.offset += 4
        let start = self.offset
        while self.offset + 2 < self.input.count() && !starts_at(self.input, self.offset, "-->") {
            if starts_at(self.input, self.offset, "--") { return (try self.failure_void(ParseErrorKind.unexpected_token, "XML comment cannot contain '--'")) }
            self.offset++
        }
        if self.offset + 2 >= self.input.count() { return (try self.failure_void(ParseErrorKind.unexpected_end, "unterminated XML comment")) }
        let value = bytes_text(self.input, start, self.offset)
        self.offset += 3
        return (try self.append(stack, Node.comment(value), stack.count()))
    }

    private func read_cdata(stack:&Node[]) Result<void, ParseError> {
        if stack.count() == 1 { return (try self.failure_void(ParseErrorKind.unexpected_token, "CDATA is not allowed outside the XML root element")) }
        self.offset += 9
        let start = self.offset
        while self.offset + 2 < self.input.count() && !starts_at(self.input, self.offset, "]]>") { self.offset++ }
        if self.offset + 2 >= self.input.count() { return (try self.failure_void(ParseErrorKind.unexpected_end, "unterminated XML CDATA section")) }
        let value = bytes_text(self.input, start, self.offset)
        self.offset += 3
        return (try self.append(stack, Node.cdata(value), stack.count()))
    }

    private func read_instruction(stack:&Node[]) Result<void, ParseError> {
        self.offset += 2
        var target = ""
        match (try self.read_name()) {
            success(value) => { target = value }
            failure(error) => { return Result<void, ParseError>.failure(error) }
        }
        self.space()
        let start = self.offset
        while self.offset + 1 < self.input.count() && !starts_at(self.input, self.offset, "?>") { self.offset++ }
        if self.offset + 1 >= self.input.count() { return (try self.failure_void(ParseErrorKind.unexpected_end, "unterminated XML processing instruction")) }
        let value = trim(bytes_text(self.input, start, self.offset))
        self.offset += 2
        if ascii_lower(target) == "xml" {
            if stack.count() != 1 || self.node_count != 1 { return (try self.failure_void(ParseErrorKind.unexpected_token, "XML declaration must be the first node")) }
            return (try self.append_instruction(stack, target, value))
        }
        return (try self.append_instruction(stack, target, value))
    }

    private func append_instruction(stack:&Node[], target:str, value:str) Result<void, ParseError> {
        var node = Node(6, target, value)
        return (try self.append(stack, node, stack.count()))
    }

    private func read_close(stack:&Node[]) Result<void, ParseError> {
        self.offset += 2
        var name = ""
        match (try self.read_name()) {
            success(value) => { name = value }
            failure(error) => { return Result<void, ParseError>.failure(error) }
        }
        self.space()
        if !self.take(62) { return (try self.failure_void(ParseErrorKind.unexpected_token, "closing XML tag must end with '>'")) }
        if stack.count() == 1 { return (try self.failure_void(ParseErrorKind.mismatched_element, "closing XML tag has no open element")) }
        if stack[stack.count() - 1].raw_name() != name {
            return (try self.failure_void(ParseErrorKind.mismatched_element, "closing XML tag '$(name)' does not match '$(stack[stack.count() - 1].raw_name())'"))
        }
        stack.take_last()
        return Result<void, ParseError>.success()
    }

    private func read_open(stack:&Node[]) Result<void, ParseError> {
        self.offset++
        var name = ""
        match (try self.read_name()) {
            success(value) => { name = value }
            failure(error) => { return Result<void, ParseError>.failure(error) }
        }
        var opened = Node.element(name)
        self.space()
        var self_closing = false
        while self.offset < self.input.count() && self.input[self.offset] != 62 {
            if self.take(47) {
                if !self.take(62) { return (try self.failure_void(ParseErrorKind.unexpected_token, "self-closing XML tag must end with '/>'")) }
                self_closing = true
                break
            }
            var attribute_name = ""
            match (try self.read_name()) {
                success(value) => { attribute_name = value }
                failure(error) => { return Result<void, ParseError>.failure(error) }
            }
            if opened.has_attribute(attribute_name) {
                return (try self.failure_void(ParseErrorKind.duplicate_attribute, "duplicate XML attribute '$(attribute_name)'"))
            }
            self.space()
            if !self.take(61) { return (try self.failure_void(ParseErrorKind.unexpected_token, "XML attribute requires '='")) }
            self.space()
            if self.offset >= self.input.count() || (self.input[self.offset] != 34 && self.input[self.offset] != 39) {
                return (try self.failure_void(ParseErrorKind.unexpected_token, "XML attribute value must be quoted"))
            }
            let quote = self.input[self.offset]
            self.offset++
            let start = self.offset
            while self.offset < self.input.count() && self.input[self.offset] != quote && self.input[self.offset] != 60 { self.offset++ }
            if self.offset >= self.input.count() || self.input[self.offset] != quote {
                return (try self.failure_void(ParseErrorKind.unexpected_end, "unterminated XML attribute value"))
            }
            let source = bytes_text(self.input, start, self.offset)
            self.offset++
            var value = ""
            match (try decode_entities(source)) {
                success(decoded) => { value = decoded }
                failure(detail) => { return (try self.failure_void(ParseErrorKind.invalid_entity, detail)) }
            }
            opened.set_attribute(attribute_name, value)
            self.space()
        }
        if !self_closing {
            if !self.take(62) { return (try self.failure_void(ParseErrorKind.unexpected_end, "unterminated XML start tag")) }
        }
        if stack.count() == 1 {
            self.root_count++
            if self.root_count > 1 { return (try self.failure_void(ParseErrorKind.multiple_roots, "XML document contains multiple root elements")) }
        }
        let depth = stack.count()
        match (try self.append(stack, opened, depth)) {
            failure(error) => { return Result<void, ParseError>.failure(error) }
            success => {}
        }
        if !self_closing {
            if depth >= self.options.maximum_depth { return (try self.failure_void(ParseErrorKind.depth_limit, "XML nesting exceeds maximum_depth")) }
            stack.append(opened)
        }
        return Result<void, ParseError>.success()
    }

    private func read_name() Result<str, ParseError> {
        if self.offset >= self.input.count() || !name_start(self.input[self.offset]) {
            return (try self.failure_text(ParseErrorKind.invalid_name, "expected an XML name"))
        }
        let start = self.offset
        self.offset++
        while self.offset < self.input.count() && name_continue(self.input[self.offset]) { self.offset++ }
        return Result<str, ParseError>.success(bytes_text(self.input, start, self.offset))
    }

    private func append(stack:&Node[], child:Node, depth:int) Result<void, ParseError> {
        if depth > self.options.maximum_depth { return (try self.failure_void(ParseErrorKind.depth_limit, "XML nesting exceeds maximum_depth")) }
        if self.node_count >= self.options.maximum_nodes { return (try self.failure_void(ParseErrorKind.node_limit, "XML document exceeds maximum_nodes")) }
        var parent = stack.take_last()
        parent.append(child)
        stack.append(parent)
        self.node_count++
        return Result<void, ParseError>.success()
    }

    private func space() {
        while self.offset < self.input.count() && whitespace(self.input[self.offset]) { self.offset++ }
    }

    private func take(byte:uint8) bool {
        if self.offset < self.input.count() && self.input[self.offset] == byte { self.offset++; return true }
        return false
    }

    private func error(kind:ParseErrorKind, detail:str) ParseError {
        var line = 1
        var column = 1
        var index = 0
        while index < self.offset {
            let byte = self.input[index]
            if byte == 10 { line++; column = 1 }
            elif byte < 128 || byte >= 192 { column++ }
            index++
        }
        return ParseError(kind:kind, byte_offset:self.offset, line:line, column:column, detail:detail)
    }

    private func failure(kind:ParseErrorKind, detail:str) Result<Node, ParseError> {
        return Result<Node, ParseError>.failure(self.error(kind, detail))
    }

    private func failure_void(kind:ParseErrorKind, detail:str) Result<void, ParseError> {
        return Result<void, ParseError>.failure(self.error(kind, detail))
    }

    private func failure_text(kind:ParseErrorKind, detail:str) Result<str, ParseError> {
        return Result<str, ParseError>.failure(self.error(kind, detail))
    }
}

func encode(node:Node, output:&uint8[], pretty:bool, depth:int, inline:bool) {
    let kind = node.raw_kind_value()
    if kind == 1 {
        for child in node.raw_children() { encode(child, output, pretty, depth, false) }
        return
    }
    if pretty && !inline { indent(output, depth) }
    if kind == 3 {
        escape(output, node.raw_value(), false)
        return
    }
    if kind == 4 {
        append(output, "<![CDATA[" + split_cdata(node.raw_value()) + "]]>")
        return
    }
    if kind == 5 {
        append(output, "<!--" + node.raw_value() + "-->")
        if pretty && !inline { output.append(10 as uint8) }
        return
    }
    if kind == 6 {
        append(output, "<?" + node.raw_name())
        if node.raw_value() != "" { append(output, " " + node.raw_value()) }
        append(output, "?>")
        if pretty && !inline { output.append(10 as uint8) }
        return
    }
    append(output, "<" + node.raw_name())
    for attribute in node.raw_attributes() {
        append(output, " " + attribute.name + "=\"")
        escape(output, attribute.value, true)
        output.append(34 as uint8)
    }
    var children = node.raw_children()
    if children.count() == 0 {
        append(output, "/>")
        if pretty && !inline { output.append(10 as uint8) }
        return
    }
    output.append(62 as uint8)
    let children_inline = contains_character_data(children)
    if pretty && !children_inline { output.append(10 as uint8) }
    for child in children { encode(child, output, pretty, depth + 1, children_inline) }
    if pretty && !children_inline { indent(output, depth) }
    append(output, "</" + node.raw_name() + ">")
    if pretty && !inline { output.append(10 as uint8) }
}

func escape(output:&uint8[], value:str, attribute:bool) {
    for byte in UTF8.bytes(value) {
        if byte == 38 { append(output, "&amp;") }
        elif byte == 60 { append(output, "&lt;") }
        elif byte == 62 { append(output, "&gt;") }
        elif attribute && byte == 34 { append(output, "&quot;") }
        else { output.append(byte) }
    }
}

func decode_entities(value:str) Result<str, str> {
    let bytes = UTF8.bytes(value)
    var output:uint8[] = []
    var index = 0
    while index < bytes.count() {
        if bytes[index] != 38 { output.append(bytes[index]); index++; continue }
        var end = index + 1
        while end < bytes.count() && bytes[end] != 59 { end++ }
        if end >= bytes.count() { return Result<str, str>.failure("unterminated XML entity reference") }
        let name = bytes_text(bytes, index + 1, end)
        if name == "amp" { append(output, "&") }
        elif name == "lt" { append(output, "<") }
        elif name == "gt" { append(output, ">") }
        elif name == "quot" { append(output, "\"") }
        elif name == "apos" { append(output, "'") }
        else {
            let scalar = entity_scalar(name)
            if scalar == 0 { return Result<str, str>.failure("unknown or invalid XML entity '&$(name);'") }
            var scalars:uint32[] = [scalar]
            match (try UTF8.from_scalars(@scalars[0:1])) {
                success(text) => { append(output, text) }
                failure(error) => { return Result<str, str>.failure("invalid XML character reference") }
            }
        }
        index = end + 1
    }
    return Result<str, str>.success(bytes_text(output, 0, output.count()))
}

func entity_scalar(name:str) uint32 {
    let bytes = UTF8.bytes(name)
    if bytes.count() < 2 || bytes[0] != 35 { return 0 }
    var base = 10
    var index = 1
    if bytes.count() > 2 && (bytes[1] == 120 || bytes[1] == 88) { base = 16; index = 2 }
    let start = index
    var result:uint32 = 0
    while index < bytes.count() {
        var digit = -1
        let byte = bytes[index]
        if byte >= 48 && byte <= 57 { digit = (byte - 48) as int }
        elif base == 16 && byte >= 65 && byte <= 70 { digit = (byte - 55) as int }
        elif base == 16 && byte >= 97 && byte <= 102 { digit = (byte - 87) as int }
        if digit < 0 { return 0 }
        result = result * (base as uint32) + digit as uint32
        if result > 1_114_111 { return 0 }
        index++
    }
    if index == start || result == 0 || (result >= 55_296 && result <= 57_343) { return 0 }
    return result
}

func valid_name(value:str) bool {
    let bytes = UTF8.bytes(value)
    if bytes.count() == 0 || !name_start(bytes[0]) { return false }
    var index = 1
    while index < bytes.count() {
        if !name_continue(bytes[index]) { return false }
        index++
    }
    return true
}

func name_start(byte:uint8) bool {
    return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 || byte == 58
}

func name_continue(byte:uint8) bool {
    return name_start(byte) || (byte >= 48 && byte <= 57) || byte == 45 || byte == 46
}

func only_space(value:str) bool {
    for byte in UTF8.bytes(value) { if !whitespace(byte) { return false } }
    return true
}

func whitespace(byte:uint8) bool { return byte == 32 || byte == 9 || byte == 10 || byte == 13 }

func append(output:&uint8[], value:str) { for byte in UTF8.bytes(value) { output.append(byte) } }

func indent(output:&uint8[], depth:int) {
    var index = 0
    while index < depth { output.append(32 as uint8); output.append(32 as uint8); index++ }
}

func contains_character_data(nodes:Node[]) bool {
    for node in nodes {
        let kind = node.raw_kind_value()
        if kind == 3 || kind == 4 { return true }
    }
    return false
}

func starts_at(input:uint8[], offset:int, expected:str) bool {
    let bytes = UTF8.bytes(expected)
    if offset + bytes.count() > input.count() { return false }
    var index = 0
    while index < bytes.count() {
        if input[offset + index] != bytes[index] { return false }
        index++
    }
    return true
}

func bytes_text(bytes:uint8[], start:int, end:int) str {
    if start >= end { return "" }
    var result:uint8[] = []
    var index = start
    while index < end { result.append(bytes[index]); index++ }
    return C.string(@result[0:result.count()])
}

func trim(value:str) str {
    let bytes = UTF8.bytes(value)
    var start = 0
    var end = bytes.count()
    while start < end && whitespace(bytes[start]) { start++ }
    while end > start && whitespace(bytes[end - 1]) { end-- }
    return bytes_text(bytes, start, end)
}

func ascii_lower(value:str) str {
    var bytes = UTF8.bytes(value)
    var index = 0
    while index < bytes.count() {
        if bytes[index] >= 65 && bytes[index] <= 90 { bytes[index] += 32 }
        index++
    }
    return bytes_text(bytes, 0, bytes.count())
}

func contains(value:str, expected:str) bool {
    let bytes = UTF8.bytes(value)
    var index = 0
    while index <= bytes.count() {
        if starts_at(bytes, index, expected) { return true }
        index++
    }
    return false
}

func ends_with(value:str, expected:str) bool {
    let bytes = UTF8.bytes(value)
    let suffix = UTF8.bytes(expected)
    if suffix.count() > bytes.count() { return false }
    return starts_at(bytes, bytes.count() - suffix.count(), expected)
}

func split_cdata(value:str) str {
    let bytes = UTF8.bytes(value)
    var output:uint8[] = []
    var index = 0
    while index < bytes.count() {
        if starts_at(bytes, index, "]]>") {
            append(output, "]]]]><![CDATA[>")
            index += 3
        } else { output.append(bytes[index]); index++ }
    }
    return bytes_text(output, 0, output.count())
}
